{
  "expo": {
    "name": "Rewind",
    "slug": "rewind",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#1A1A1C",
    "scheme": "rewind",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/00000000-0000-0000-0000-000000000000"
    },
    "extra": {
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rewind.app",
      "deploymentTarget": "16.4",
      "backgroundColor": "#1A1A1C",
      "infoPlist": {
        "NSCameraUsageDescription": "Rewind needs camera access to capture your daily photos.",
        "NSPhotoLibraryUsageDescription": "Rewind needs photo library access to set your profile avatar."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A1A1C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "backgroundColor": "#1A1A1C",
      "package": "com.rewind.app",
      "permissions": [
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#1A1A1C"
        }
      ],
      "expo-font",
      "expo-image",
      [
        "react-native-vision-camera",
        {
          "cameraPermission": "Rewind needs camera access to capture your daily photos.",
          "enableFrameProcessors": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Rewind needs camera access to capture your daily photos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Rewind needs photo library access to set your profile avatar."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Rewind to save photos and timelapses to your library.",
          "savePhotosPermission": "Allow Rewind to save photos and timelapses to your library."
        }
      ],
      "expo-document-picker",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Rewind uses Face ID to protect locked albums."
        }
      ],
      "expo-localization"
    ]
  }
}
